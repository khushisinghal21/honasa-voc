# Copy to .env and fill in. Never commit .env.

# LLM: "anthropic" for real runs, "baseline" for the rule-based extractor (no key needed)
VOC_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
# Fast model does bulk extraction; smart model labels themes, routes ambiguous cases, judges evals.
VOC_FAST_MODEL=claude-haiku-4-5-20251001
VOC_SMART_MODEL=claude-sonnet-5-5
# Used only for the cost report (USD per million tokens). Check current pricing and update.
VOC_PRICE_FAST_IN=1.0
VOC_PRICE_FAST_OUT=5.0
VOC_PRICE_SMART_IN=3.0
VOC_PRICE_SMART_OUT=15.0

# Embeddings: auto | st | tfidf. "st" needs `pip install -e ".[ml]"`.
VOC_EMBED_BACKEND=auto
VOC_EMBED_MODEL=intfloat/multilingual-e5-small

# Collectors
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=honasa-voc-poc/0.1 by u/your_username

# Salt for hashing author IDs. Set any random string and keep it stable.
VOC_AUTHOR_SALT=change-me
